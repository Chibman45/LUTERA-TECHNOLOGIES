{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "python3 scripts/build_vercel.py",
  "outputDirectory": "_site",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www\\.luteratech\\.com"
        }
      ],
      "destination": "https://luteratech.com/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "luteratech\\.com\\.ng"
        }
      ],
      "destination": "https://luteratech.com/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www\\.luteratech\\.com\\.ng"
        }
      ],
      "destination": "https://luteratech.com/:path",
      "permanent": true
    },
    {
      "source": "/LUTERA-TECHNOLOGIES/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/LUTERA-TECHNOLOGIES/:path*/",
      "destination": "/:path*/",
      "permanent": true
    },
    {
      "source": "/LUTERA-TECHNOLOGIES",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/LUTERA-TECHNOLOGIES/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ]
}
